#include <windows.h>

// Icone do executavel. O .ico e gerado por tools/make-icon.ps1.
#define IDI_ICON1 101
IDI_ICON1 ICON "pistaforge.ico"

// Metadados exibidos nas propriedades do arquivo.
// Texto em ASCII para nao depender da code page do rc.exe.
VS_VERSION_INFO VERSIONINFO
    FILEVERSION PF_FILE_VERSION
    PRODUCTVERSION PF_FILE_VERSION
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS PF_FILE_FLAGS
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PistaForge"
            VALUE "FileDescription", "PistaForge - editor de pistas de corrida"
            VALUE "FileVersion", PF_VERSION_STRING
            VALUE "InternalName", "PistaForge"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "PistaForge.exe"
            VALUE "ProductName", "PistaForge"
            VALUE "ProductVersion", PF_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
